generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// URL подключения задаётся в prisma.config.ts (Prisma ORM 7), не здесь.
datasource db {
  provider = "postgresql"
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  CANCELLED
}

model Brand {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  logoUrl    String?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  brand          Brand     @relation(fields: [brandId], references: [id])
  brandId        String
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  h1             String?
  products       Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([isActive])
}

/** Ценообразующие атрибуты (Память, SIM/eSIM, ...) и атрибуты-цвета —
 * различаются флагом isColor. Цвет НЕ участвует в ProductVariant/цене,
 * см. ProductColorValue. Новый тип атрибута создаётся из админки, без правки кода. */
model VariantAttribute {
  id        String                  @id @default(cuid())
  name      String
  slug      String                  @unique
  sortOrder Int                     @default(0)
  isColor   Boolean                 @default(false)
  values    VariantAttributeValue[]
  products  ProductVariantAttribute[]

  createdAt DateTime @default(now())
}

model VariantAttributeValue {
  id          String           @id @default(cuid())
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId String
  value       String
  sortOrder   Int              @default(0)
  /** Только для атрибутов с isColor=true — свотч в UI. */
  colorHex    String?

  variantOptions ProductVariantOption[]
  colorOfProduct ProductColorValue[]

  createdAt DateTime @default(now())

  @@unique([attributeId, value])
  @@index([attributeId])
}

model Product {
  id               String       @id @default(cuid())
  slug             String       @unique
  category         Category     @relation(fields: [categoryId], references: [id])
  categoryId       String
  name             String
  shortDescription String?
  description      String?
  isFlagship       Boolean      @default(false)
  isActive         Boolean      @default(true)
  /** Fallback-цена, используется только если у товара нет ни одного ProductVariant. */
  basePriceUsd     Decimal      @db.Decimal(10, 2)
  availability     Availability @default(IN_STOCK)
  sortOrder        Int          @default(0)
  seoTitle         String?
  seoDescription   String?
  canonicalPath    String?

  variants          ProductVariant[]
  colorValues       ProductColorValue[]
  images            ProductImage[]
  specs             ProductSpec[]
  orderItems        OrderItem[]
  variantAttributes ProductVariantAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isFlagship])
  @@index([isActive])
}

/** Фактическая закупаемая комбинация не-цветовых атрибутов (память, SIM, ...)
 * с собственной ценой/наличием. Создаётся вручную в админке, не автогенерацией. */
model ProductVariant {
  id           String       @id @default(cuid())
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  priceUsd     Decimal      @db.Decimal(10, 2)
  sku          String?
  availability Availability @default(IN_STOCK)
  isDefault    Boolean      @default(false)
  sortOrder    Int          @default(0)

  options    ProductVariantOption[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/** Какие не-цветовые атрибуты вообще выбраны для этого товара в админке
 * (чекбокс "использовать в этом товаре", задача 54) — независимо от того,
 * создана ли уже хоть одна SKU-комбинация с этим атрибутом. Без этой
 * таблицы не было бы способа отличить "атрибут ещё не задействован ни в
 * одном варианте" от "атрибут вообще не предполагается для этого товара". */
model ProductVariantAttribute {
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId String

  @@id([productId, attributeId])
  @@index([attributeId])
}

/** Многие-ко-многим: какие значения не-цветовых атрибутов образуют вариант.
 * Подбор варианта на витрине — точное совпадение всего набора, не пересечение. */
model ProductVariantOption {
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId        String
  attributeValue   VariantAttributeValue  @relation(fields: [attributeValueId], references: [id])
  attributeValueId String

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

/** Какие цвета вообще доступны у товара — отдельно от ProductVariant,
 * цвет не влияет на цену, только на подбор фото (ProductImage.colorValueId). */
model ProductColorValue {
  id               String                @id @default(cuid())
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  attributeValue   VariantAttributeValue @relation(fields: [attributeValueId], references: [id])
  attributeValueId String

  images ProductImage[]

  @@unique([productId, attributeValueId])
  @@index([attributeValueId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  /** Опциональная привязка к конкретному цвету товара; если для выбранного
   * цвета фото нет — витрина показывает isMain-фото (fallback), не заглушку. */
  colorValue   ProductColorValue? @relation(fields: [colorValueId], references: [id], onDelete: SetNull)
  colorValueId String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([colorValueId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

/** Append-only: текущий курс = последняя запись по setAt, апдейт старой строки не делаем —
 * так сохраняется история изменений курса. */
model ExchangeRate {
  id       String   @id @default(cuid())
  usdToByn Decimal  @db.Decimal(10, 4)
  setAt    DateTime @default(now())
  setBy    String?

  @@index([setAt])
}

model Order {
  id       String      @id @default(cuid())
  name     String
  phone    String
  comment  String?
  status   OrderStatus @default(NEW)
  totalByn Int

  exchangeRateUsed Decimal @db.Decimal(10, 4)

  telegramSentAt DateTime?
  /** Результат отправки по каждому chat_id (доставлено/ошибка) — структурировано, не одной строкой. */
  telegramDeliveryLog Json?

  items OrderItem[]

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/** Снимки названия/цены/варианта обязательны: товар, вариант и курс
 * могут измениться или быть удалены уже после того, как заказ оформлен. */
model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?

  productNameSnapshot  String
  variantLabelSnapshot String?
  colorLabelSnapshot   String?
  priceUsdSnapshot     Decimal @db.Decimal(10, 2)
  priceBynSnapshot     Int
  quantity             Int

  @@index([orderId])
}
