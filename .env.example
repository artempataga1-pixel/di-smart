# База данных (PostgreSQL, задача 24 — Prisma-схема)
# Хост "db" — имя сервиса из docker-compose.yml (для запуска app внутри Docker).
# При запуске Next.js вне контейнера (`npm run dev` на хосте) замени "db" на "localhost".
DATABASE_URL=postgresql://postgres:postgres@db:5432/di_smart?schema=public

# Данные для контейнера Postgres в docker-compose.yml (должны совпадать с DATABASE_URL выше)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=di_smart

# Порт, на котором docker-compose публикует приложение наружу
APP_PORT=3000

# Админка (задача 47 — авторизация)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram-бот для заявок (задача 44)
TELEGRAM_BOT_TOKEN=
# Список chat_id получателей заявок, через запятую
TELEGRAM_CHAT_IDS=

# Публичный URL сайта (для sitemap.ts, OG-тегов и т.д.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Аналитика и верификация поисковых систем (задачи 62-63)
YANDEX_METRIKA_ID=
GSC_VERIFICATION=
YANDEX_VERIFICATION=
